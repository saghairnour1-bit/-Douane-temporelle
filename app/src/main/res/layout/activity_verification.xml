<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#EAF0F8"
    android:padding="12dp">

    <!-- Image à gauche : poids 0.3 -->
    <ImageView
        android:id="@+id/img_passport_nj"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:src="@android:drawable/ic_menu_myplaces"
        android:scaleType="centerInside"
        android:contentDescription="Photo du voyageur"/>

    <!-- Partie droite : poids 0.7 -->
    <RelativeLayout
        android:id="@+id/relative_passport_nj"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:background="#FFFFFF"
        android:padding="12dp">

        <TextView
            android:id="@+id/txt_titre_nj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PASSEPORT TEMPOREL"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#173B68"
            android:gravity="center"/>

        <TextView
            android:id="@+id/txt_nom_nj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nom : "
            android:textSize="16sp"
            android:textColor="#222222"
            android:layout_below="@id/txt_titre_nj"
            android:layout_marginTop="30dp"/>

        <TextView
            android:id="@+id/txt_age_nj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Âge temporel : "
            android:textSize="16sp"
            android:textColor="#222222"
            android:layout_below="@id/txt_nom_nj"
            android:layout_marginTop="20dp"/>

        <TextView
            android:id="@+id/txt_motif_nj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Motif : "
            android:textSize="16sp"
            android:textColor="#222222"
            android:layout_below="@id/txt_age_nj"
            android:layout_marginTop="20dp"/>

        <Button
            android:id="@+id/btn_approuver_nj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Approuver le saut temporel"
            android:textSize="12sp"
            android:layout_below="@id/txt_motif_nj"
            android:layout_marginTop="35dp"/>

        <Button
            android:id="@+id/btn_refuser_nj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Refuser (Risque de paradoxe)"
            android:textSize="12sp"
            android:layout_below="@id/btn_approuver_nj"
            android:layout_marginTop="12dp"/>

    </RelativeLayout>

</LinearLayout>
