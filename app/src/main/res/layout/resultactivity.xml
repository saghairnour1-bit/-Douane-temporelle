
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_result_nj"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="25dp"
    android:background="#C8F0D2">

    <TextView
        android:id="@+id/txt_verdict_nj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VOYAGE APPROUVÉ"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#006E28"
        android:gravity="center"
        android:layout_marginBottom="25dp"/>

    <TextView
        android:id="@+id/txt_message_nj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bon voyage !"
        android:textSize="20sp"
        android:textColor="#222222"
        android:gravity="center"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btn_nouveau_nj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nouveau voyageur"/>

</LinearLayout>
